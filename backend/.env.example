NODE_ENV=development
# Porta e interface de escuta. Em produção atrás do Nginx: HOST=127.0.0.1 e porta interna (ex.: 3000/9090).
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Quantos proxies confiáveis (Nginx) ficam à frente da API. Vazio = 1 em produção, 0 nos demais ambientes.
TRUST_PROXY=
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>/?retryWrites=true&w=majority
MONGO_DB_NAME=test
# Opcional: use apenas se a rede exigir servidores DNS explicitos para SRV do Atlas
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:8081
API_PUBLIC_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@example.com
# Base OTLP/HTTP (o código acrescenta /v1/traces). Local (Jaeger): http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Chave do provedor (Datadog/New Relic), somente no .env do servidor: OTEL_EXPORTER_OTLP_HEADERS=<cabecalho>=<CHAVE>
# OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=sistema-salao-api
BOOTSTRAP_ADMIN_NAME=Nicolle
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=48f5951364e9fd
SMTP_PASSWORD=d9226c1667f714

CORS_ORIGIN=http://localhost:8081
API_PUBLIC_URL=http://localhost:3000