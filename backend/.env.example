NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>/?retryWrites=true&w=majority
MONGO_DB_NAME=test
# Opcional: use apenas se a rede exigir servidores DNS explicitos para SRV do Atlas
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:8081
API_PUBLIC_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@example.com
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sistema-salao-api
BOOTSTRAP_ADMIN_NAME=Nicolle
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password